    <script type="text/javascript">

        function fn_autoselect(element, url, hiddenField) {
            $.ajax({
                url: url,
                method: 'GET',
                success: function (result) {
                    const dataList = result.map(data => ({
                        label: data.unitName || data.itemName,
                        value: data.unitId || data.itemId
                    }));

                    $(element).autocomplete({
                        source: dataList,
                        minLength: 0,
                        select: function (event, ui) {
                            event.preventDefault();
                            $(element).val(ui.item.label);
                            $(hiddenField).val(ui.item.value);
                        },
                        focus: function () {
                            return false;
                        }
                    }).focus(function () {
                        $(this).autocomplete("search", "");
                    });
                },
                error: function (err) {
                    console.error("Failed to fetch data:", err);
                }
            });
        }

                     $(document).ready(function () {
            const userSitesCount = @userSitesCount;

            if (userSitesCount === 0) {
                fetchSiteNameList();
            } else {

                const selectedSiteId = sessionStorage.getItem('SelectedSiteId');
                if (selectedSiteId) {
                    $('#drpSiteName').val(selectedSiteId);
                }
            }

            $('#drpSiteName').change(function () {
                const selectedSiteId = $(this).val();
                const siteText = $(this).find('option:selected').text();
                fn_ChangeSite(selectedSiteId, siteText);
            });
        });

        function fetchSiteNameList() {
            $.ajax({
                url: '/SiteMaster/GetSiteNameList',
                type: 'GET',
                success: function (siteList) {
                    const $dropdown = $('#drpSiteName');
                    $dropdown.empty().append('<option value="">All Site</option>');
                    siteList.forEach(site => {
                        $dropdown.append(`<option value="${site.siteId}">${site.siteName}</option>`);
                    });


                    const selectedSiteId = sessionStorage.getItem('SelectedSiteId');
                    if (selectedSiteId) {
                        $dropdown.val(selectedSiteId);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching site list:", error);
                }
            });
        }

        function fn_ChangeSite(selectedSiteId, siteText) {
            $.ajax({
                url: '/Home/PurchaseRequestList',
                type: 'GET',
                data: {
                    SiteId: selectedSiteId,
                    SiteName: siteText
                },
                success: function (result) {
                    $("#tbPndingApproval").html(result);
                    sessionStorage.setItem('SelectedSiteId', selectedSiteId);
                    location.reload();
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching purchase request list:", error);
                }
            });
        }

    </script>


