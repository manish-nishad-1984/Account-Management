@using AccountManegments.Web.Models;
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession
@inject Microsoft.Extensions.Configuration.IConfiguration _Configuration
<!doctype html>
<html lang="en" class="light-theme">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!--plugins-->
    <link href="@(Url.Content("~/assets/plugins/simplebar/css/simplebar.css"))" rel="stylesheet" />

    <link href="@(Url.Content("~/assets/plugins/metismenu/css/metisMenu.min.css"))" rel="stylesheet" />
    <link href="@(Url.Content("~/assets/plugins/sweetalert2/sweetalert2.min.css"))" rel="stylesheet" />


    <!-- CSS Files -->
    <link href="@(Url.Content("~/css/site.css"))" rel="stylesheet" />
    <link href="@(Url.Content("~/assets/css/bootstrap.min.css"))" rel="stylesheet">
    <link href="@(Url.Content("~/assets/css/bootstrap-extended.css"))" rel="stylesheet">
    <link href="@(Url.Content("~/assets/css/style.css"))" rel="stylesheet">
    <link href="@(Url.Content("~/assets/css/icons.css"))" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.3/themes/base/jquery-ui.css">
    <script src="https://cdn.ckeditor.com/ckeditor5/36.0.0/classic/ckeditor.js"></script>
    <!--Theme Styles-->
    <link href="@(Url.Content("~/assets/css/dark-theme.css"))" rel="stylesheet" />
    <link href="@(Url.Content("~/assets/css/semi-dark.css"))" rel="stylesheet" />
    <link href="@(Url.Content("~/assets/css/header-colors.css"))" rel="stylesheet" />
    <link href="@(Url.Content("~/lib/select2/css/select2.css"))" rel="stylesheet" />
    <link href="@(Url.Content("~/lib/select2/css/select2.min.css"))" rel="stylesheet" />
    <link href="@(Url.Content("~/lib/select2-bootstrap4-theme/select2-bootstrap4.css"))" rel="stylesheet" />
    <link href="@(Url.Content("~/lib/select2-bootstrap4-theme/select2-bootstrap4.min.css"))" rel="stylesheet" />


    <!--datatable css-->
    <link href="@(Url.Content("~/assets/plugins/datatable/css/dataTables.bootstrap5.min.css"))" rel="stylesheet" />
    <link href="@(Url.Content("~/assets/plugins/cdn.datatables.net/1.11.5/css/datatables.bootstrap5.min.css"))" rel="stylesheet" />
    <link href="@(Url.Content("~/assets/plugins/cdn.datatables.net/buttons/2.2.2/css/buttons.datatables.min.css"))" rel="stylesheet" />
    <link href="@(Url.Content("~/assets/plugins/cdn.datatables.net/responsive/2.2.9/css/responsive.bootstrap.min.css"))" rel="stylesheet" />
    <!--datatable responsive css-->

    <link href="@(Url.Content("~/assets/css/style.css"))" rel="stylesheet" />

    <style>
        .fixed-button {
            position: fixed;
            top: 80px;
            right: 20px;
        }

        .ui-front {
            z-index: 1100 !important;
            max-height: 150px;
            overflow: hidden scroll;
        }

        .fixedButton {
            position: fixed;
            top: 80px;
            right: 170px;
        }

        .fixed-button {
            position: fixed;
            top: 80px;
            right: 20px;
        }

        .fixedButton {
            position: fixed;
            top: 80px;
            right: 170px;
        }

        /* ===================== Full Responsive Helpers (paste at end of <style>) ===================== */

        /* Generic responsive helpers */
        .select2-container {
            width: 100% !important;
        }

            .select2-container .select2-selection {
                min-height: calc(1.5em + .75rem + 2px);
            }

        /* ---------------- Off-canvas / Sidebar behavior for medium & small screens ---------------- */
                            @@media (max-width: 1199px) {
            .sidebar-wrapper

        {
            position: fixed;
            left: -280px;
            top: 0;
            height: 100vh;
            width: 260px;
            overflow-y: auto;
            z-index: 1400;
            transition: left .25s ease, transform .25s ease;
            -webkit-overflow-scrolling: touch;
            background: inherit;
        }

        /* support common toggle class names that JS might add */
        .sidebar-wrapper.active,
        .sidebar-wrapper.open,
        .sidebar-wrapper.show,
        body.sidebar-open .sidebar-wrapper {
            left: 0 !important;
            box-shadow: 0 6px 20px rgba(0,0,0,0.12);
        }

        /* overlay: shown when sidebar is open */
        .overlay.nav-toggle-icon {
            display: none;
        }

            .overlay.nav-toggle-icon.active,
            .overlay.nav-toggle-icon.show,
            body.sidebar-open .overlay.nav-toggle-icon {
                display: block;
                position: fixed;
                inset: 0;
                z-index: 1350;
                background: rgba(0,0,0,0.45);
            }

        /* ensure top content doesn't get hidden; keep page content full width by default */
        .page-content-wrapper {
            margin-left: 0 !important;
            transition: margin-left .25s ease, padding .25s ease;
            padding: 12px;
        }

        /* toggle icon visibility */
        .toggle-icon {
            display: inline-block;
            cursor: pointer;
            z-index: 1500;
        }

        /* menu layout adjustments for touch */
        .metismenu {
            padding-bottom: 100px;
        }

            .metismenu li {
                width: 100%;
            }

                .metismenu li a {
                    padding: 10px 18px;
                    display: flex;
                    align-items: center;
                    gap: 12px;
                }

                .metismenu li ul {
                    display: none;
                    padding-left: 10px;
                }
                /* allow metismenu/mm-js classes to reveal submenus */
                .metismenu li .mm-show,
                .metismenu li .show,
                .metismenu li .mm-active > ul {
                    display: block !important;
                }

        /* make parent icons aligned */
        .parent-icon {
            width: 36px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
        }

        }

        /* ---------------- Tablet / small-desktop adjustments ---------------- */
                            @@media (max-width: 991px) {
            .logo-text

        {
            font-size: 18px;
        }

        #drpSiteName {
            width: 100%;
            margin-bottom: 8px;
        }

        .user-setting img {
            width: 36px;
            height: 36px;
        }

        .user-setting span {
            display: none;
        }
        /* hide full name to save space */
        .page-breadcrumb {
            font-size: 13px;
        }

        .fixed-button, .fixedButton {
            right: 16px;
        }

        }

        /* ---------------- Mobile: make tables usable & reduce paddings ---------------- */
                            @@media (max-width: 767px) {
            .sidebar-wrapper

        {
            width: 220px;
            left: -240px;
        }

        .menu-title {
            font-size: 14px;
        }

        .page-breadcrumb .breadcrumb {
            font-size: 12px;
        }

        .top-header .navbar {
            padding: 8px;
        }

        #drpSiteName {
            font-size: 13px;
            padding: 6px 10px;
        }

        /* DataTables / tables: horizontal scroll + smaller cells */
        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            -ms-overflow-style: -ms-autohiding-scrollbar;
        }

        table.dataTable, table {
            width: auto !important;
            min-width: 700px;
            table-layout: auto;
        }

            table.dataTable th, table.dataTable td, table th, table td {
                white-space: nowrap;
                padding: 8px 10px;
                font-size: 13px;
            }

        /* stack datatable controls */
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_length {
            float: none;
            width: 100%;
            display: flex;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 8px;
        }

        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            text-align: center;
            width: 100%;
            margin-top: 8px;
            display: block;
        }

        /* datatable buttons wrap */
        .dt-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        /* reduce header/footer spacing */
        .page-content-wrapper {
            padding: 10px;
        }

        }

        /* ---------------- Very small phones ---------------- */
        @@media (max-width: 480px) {
            body {
                font-size: 13px;
            }

            .sidebar-wrapper {
                width: 200px;
                left: -220px;
            }

            .menu-title {
                font-size: 13px;
            }

            .page-content-wrapper {
                padding: 6px;
            }

            .metismenu li a {
                padding: 8px 12px;
            }

            table.dataTable, table {
                min-width: 600px;
            }

                table th, table td {
                    padding: 6px 8px;
                    font-size: 12px;
                }

            .toggle-icon ion-icon {
                font-size: 22px;
            }
        }

        /* ---------------- Optional: CSS-only stacked card style for tables on very small screens ----------------
                   To use this: wrap the table in a div.responsive-stack and add data-label attributes to each <td>
                   Example:
                   <div class="responsive-stack">
                     <table> <thead>... </thead> <tbody>
                       <tr>
                         <td data-label="Invoice No">INV001</td>
                         <td data-label="Date">2025-01-01</td>
                         ...
                       </tr>
                     </tbody></table>
                   </div>
                */
        @@media (max-width: 480px) {
            .responsive-stack table, .responsive-stack thead {
                display: block;
                width: 100%;
            }

            .responsive-stack tbody {
                display: block;
                max-height: 60vh;
                overflow: auto;
                -webkit-overflow-scrolling: touch;
            }

            .responsive-stack tr {
                display: block;
                border-bottom: 1px solid #eee;
                margin-bottom: 10px;
                padding-bottom: 6px;
            }

            .responsive-stack td {
                display: flex;
                justify-content: space-between;
                padding: 8px 6px;
                white-space: normal;
            }

                .responsive-stack td::before {
                    content: attr(data-label);
                    font-weight: 600;
                    margin-right: 8px;
                    color: #333;
                }

            .responsive-stack th {
                display: none;
            }
        }

        /* ---------------- Small visual tweaks to keep layout tight on mobile ---------------- */
        @@media (max-width: 992px) {
            .parent-icon svg, .parent-icon i, .parent-icon ion-icon, .parent-icon img {
                font-size: 18px;
                width: 22px;
                height: 22px;
            }

            .menu-title {
                line-height: 1.2;
            }
        }

        /* Ensure long breadcrumbs and other texts wrap */
        .breadcrumb, .breadcrumb-item, .page-breadcrumb nav {
            word-wrap: break-word;
        }

        /* keep table-hover UX on small view */
        .table tbody tr {
            transition: background .12s ease;
        }

        /* small helper: ensure the back-to-top and fixed buttons don't overlap critical UI on tiny screens */
        @@media (max-width: 400px) {
            .back-to-top {
                right: 8px;
                bottom: 12px;
            }

            .fixed-button, .fixedButton {
                right: 60px;
                bottom: 12px;
            }
        }

                                @@media (max-width: 768px) {
            .sidebar-wrapper

        {
            background-color: #2c003e !important; /* dark purple/navy */
        }

        .sidebar-wrapper .menu-title,
        .sidebar-wrapper a {
            color: #fff !important; /* white text for visibility */
        }

        }
    </style>

    <title>@ViewData["Title"] - @_Configuration.GetSection("ProjectName")?.Value </title>
</head>

<body>
    <!--start wrapper-->
    <div class="wrapper">

        <!--start sidebar -->
        <aside class="sidebar-wrapper" data-simplebar="true">
            <div class="sidebar-header">
                <div>
                    <h4 class="logo-text">@_Configuration.GetSection("ProjectName")?.Value </h4>
                </div>
                <div class="toggle-icon ms-auto">
                    <ion-icon name="menu-sharp"></ion-icon>
                </div>
            </div>
            <ul class="metismenu" id="menu">
                @foreach (var group in UserSession.FormPermisionData.Select(a => a.GroupName).Distinct())
                {   @if (group == "Dashboard" && UserSession.FormPermisionData.Count(e => e.GroupName == group) > 0)
                    {
                        @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                        {
                            <li>
                                <a asp-action="@item.Action" asp-controller="@item.Controller">
                                    <div class="parent-icon">
                                        <ion-icon name="home-sharp"></ion-icon>
                                    </div>
                                    <div class="menu-title">@item.FormName</div>
                                </a>
                            </li>
                        }

                    }
                    @if (group == "Master" && UserSession.FormPermisionData.Count(e => e.GroupName == group && e.View == true) > 0)
                    {
                        <li>
                            <a class="has-arrow">
                                <div class="parent-icon">
                                    <ion-icon name="lock-closed-sharp"></ion-icon>
                                </div>
                                <div class="menu-title">Master</div>
                            </a>
                            <ul>
                                @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                                {
                                    @if (item.View)
                                    {
                                        <li>
                                            <a asp-action="@item.Action" asp-controller="@item.Controller">
                                                <div class="parent-icon">
                                                    <ion-icon name="ellipse-outline" role="img" class="md hydrated" aria-label="ellipse outline"></ion-icon>
                                                </div>
                                                <div class="menu-title">@item.FormName</div>
                                            </a>
                                        </li>
                                    }
                                }

                            </ul>
                        </li>
                    }
                    @if (group == "Supplier" && UserSession.FormPermisionData.Count(e => e.GroupName == group) > 0)
                    {
                        @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                        {
                            @if (item.View)
                            {
                                <li>
                                    <a asp-action="@item.Action" asp-controller="@item.Controller">
                                        <div class="parent-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-truck"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                                        </div>
                                        <div class="menu-title">@item.FormName</div>
                                    </a>
                                </li>
                            }
                        }
                    }
                    @if (group == "Item" && UserSession.FormPermisionData.Count(e => e.GroupName == group) > 0)
                    {
                        @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                        {
                            @if (item.View)
                            {
                                <li>
                                    <a asp-action="@item.Action" asp-controller="@item.Controller">
                                        <div class="parent-icon">
                                            <i class="lni lni-cart-full"></i>
                                        </div>
                                        <div class="menu-title">@item.FormName</div>
                                    </a>
                                </li>
                            }
                        }
                    }
                    @if (group == "Reports" && UserSession.FormPermisionData.Count(e => e.GroupName == group) > 0)
                    {
                        @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                        {
                            @if (item.View)
                            {
                                <li>
                                    <a asp-action="@item.Action" asp-controller="@item.Controller">
                                        <div class="parent-icon">
                                            <i class="lni lni-credit-cards"></i>
                                        </div>
                                        <div class="menu-title">@item.FormName</div>
                                    </a>
                                </li>
                            }
                        }
                    }
                    @if (group == "Inventory Inward" && UserSession.FormPermisionData.Count(e => e.GroupName == group) > 0)
                    {
                        @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                        {
                            @if (item.View)
                            {
                                <li>
                                    <a asp-action="@item.Action" asp-controller="@item.Controller">
                                        <div class="parent-icon">

                                            <i class="fadeIn animated bx bx-store-alt"></i>
                                        </div>
                                        <div class="menu-title">@item.FormName</div>
                                    </a>
                                </li>
                            }
                        }
                    }

                    @if (group == "Sales Invoice" && UserSession.FormPermisionData.Count(e => e.GroupName == group) > 0)
                    {
                        @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                        {
                            @if (item.View)
                            {
                                <li>
                                    <a asp-action="@item.Action" asp-controller="@item.Controller">
                                        <div class="parent-icon">
                                            <i class="fadeIn animated bx bx-receipt"></i>
                                        </div>
                                        <div class="menu-title">@item.FormName</div>
                                    </a>
                                </li>
                            }
                        }
                    }

                    @if (group == "Sales Report" && UserSession.FormPermisionData.Count(e => e.GroupName == group) > 0)
                    {
                        @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                        {
                            @if (item.View)
                            {
                                <li>
                                    <a asp-action="@item.Action" asp-controller="@item.Controller">
                                        <div class="parent-icon">
                                            <i class="lni lni-book"></i>
                                        </div>
                                        <div class="menu-title">@item.FormName</div>
                                    </a>
                                </li>
                            }
                        }
                    }
                    @if (group == "Users Master" && UserSession.FormPermisionData.Count(e => e.GroupName == group && e.View == true) > 0)
                    {
                        <li>

                            <a class="has-arrow">
                                <div class="parent-icon">
                                    <ion-icon name="person-circle-sharp"></ion-icon>
                                </div>
                                <div class="menu-title">User Master</div>
                            </a>
                            <ul>
                                @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                                {
                                    @if (item.View)
                                    {
                                        <li>

                                            <a asp-action="@item.Action" asp-controller="@item.Controller">
                                                <ion-icon name="ellipse-outline"></ion-icon>@item.FormName
                                            </a>
                                        </li>
                                    }
                                }

                            </ul>
                        </li>
                    }
                    @if (group == "Inward Challan" && UserSession.FormPermisionData.Count(e => e.GroupName == group) > 0)
                    {
                        @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                        {
                            @if (item.View)
                            {
                                <li>
                                    <a asp-action="@item.Action" asp-controller="@item.Controller">
                                        <div class="parent-icon">
                                            <ion-icon name="create-sharp"></ion-icon>
                                        </div>
                                        <div class="menu-title">@item.FormName</div>
                                    </a>
                                </li>
                            }
                        }
                    }
                    @if (group == "Purchase  Invoice" && UserSession.FormPermisionData.Count(e => e.GroupName == group) > 0)
                    {
                        @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                        {
                            @if (item.View)
                            {
                                <li>
                                    <a asp-action="@item.Action" asp-controller="@item.Controller">
                                        <div class="parent-icon">
                                            <ion-icon name="newspaper-sharp"></ion-icon>
                                        </div>
                                        <div class="menu-title">@item.FormName</div>
                                    </a>
                                </li>
                            }
                        }

                    }
                    @if (group == "Purchase Order" && UserSession.FormPermisionData.Count(e => e.GroupName == group) > 0)
                    {
                        <li>

                            @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                            {
                                @if (item.View)
                                {
                                <li>

                                    <a asp-action="@item.Action" asp-controller="@item.Controller">
                                        <div class="font-22">
                                            <i class="lni lni-clipboard"></i>
                                        </div>
                                        <div class="menu-title">@item.FormName</div>
                                    </a>
                                </li>
                                }
                            }

                        </li>
                    }
                    @if (group == "Purchase Request" && UserSession.FormPermisionData.Count(e => e.GroupName == group) > 0)
                    {
                        @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                        {@if (item.View)
                            {
                                <li>
                                    <a asp-action="@item.Action" asp-controller="@item.Controller">
                                        <div class="parent-icon">
                                            <ion-icon name="bag-handle-sharp"></ion-icon>
                                        </div>
                                        <div class="menu-title">@item.FormName</div>
                                    </a>
                                </li>
                            }
                        }    }
                    @if (group == "Payment Out" && UserSession.FormPermisionData.Count(e => e.GroupName == group) > 0)
                    {
                        @foreach (var item in UserSession.FormPermisionData.Where(e => e.GroupName == group))
                        {
                            @if (item.View)
                            {
                                <li>
                                    <a asp-action="@item.Action" asp-controller="@item.Controller">
                                        <div class="font-22">
                                            <i class="lni lni-remove-file"></i>

                                        </div>
                                        <div class="menu-title">@item.FormName</div>
                                    </a>
                                </li>
                            }
                        }
                    }

                }
            </ul>
            <!--end navigation-->
        </aside>
        <!--end sidebar -->
        <!--start top header-->
        <header class="top-header">
            <nav class="navbar navbar-expand gap-3">
                @{
                    var userSites = UserSession.SiteData;
                    var selectedSiteId = UserSession.SiteId;
                    var userSitesCount = (userSites != null) ? userSites.Count : 0;
                }

                <form id="frmdrpdashbord">
                    <select class="form-select form-control-lg" id="drpSiteName" name="drpSiteName">
                        @if (userSites != null && userSites.Any())
                        {
                            foreach (var site in userSites)
                            {
                                var isSelected = site.SiteId.ToString().Equals(selectedSiteId, StringComparison.OrdinalIgnoreCase) ? "selected" : "";
                                <option value="@site.SiteId" isSelected>@site.SiteName</option>
                            }
                        }
                    </select>
                </form>


                <h5 id="siteErrorMesssage">
                </h5>
                <div class="top-navbar-right ms-auto">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item dropdown dropdown-user-setting">
                            <a class="nav-link dropdown-toggle dropdown-toggle-nocaret" href="javascript:;" data-bs-toggle="dropdown">
                                <div class="user-setting">
                                    <img src="~/assets/images/avatars/06.png" class="user-img" alt=""><span style="margin-left:10px">@_userSession.FullName</span>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="javascript:;">
                                        <div class="d-flex flex-row align-items-center gap-2">
                                            <img src="~/assets/images/avatars/06.png" alt="" class="rounded-circle" width="54" height="54">
                                            <div class="">
                                                <p class="mb-0 dropdown-user-name">@_userSession.FullName</p>

                                            </div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" onclick="UserLogout()">
                                        <div class="d-flex align-items-center">
                                            <div class="">
                                                <ion-icon name="log-out-outline"></ion-icon>
                                            </div>
                                            <div class="ms-3"><span>Logout</span></div>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>
        <!--end top header-->
        <!-- start page content wrapper-->
        <div class="page-content-wrapper">
            <!-- start page content-->
            <div class="page-content">
                <div class="d-sm-flex align-items-center mb-6">
                    <div class="page-breadcrumb d-flex align-items-center">
