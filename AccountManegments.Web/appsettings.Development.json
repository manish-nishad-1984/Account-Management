{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Development talks to the API running locally, NOT to production.
  // The API's HTTPS profile is https://localhost:7251 (Properties/launchSettings.json).
  "AppSetting": {
    "WebAPIBaseUrl": "https://localhost:7251/api/",
    "WebAPIUrl": "https://localhost:7251/api"
  }
}
